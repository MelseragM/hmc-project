    { "key": "payperiod", "value": "January 2024", "type": "string" },
    { "key": "assignmentid", "value": "7179444713", "type": "string" },
    { "key": "acadyrstrtdt", "value": "20200202", "type": "string" },
    { "key": "approvalId", "value": "99001", "type": "string" },
