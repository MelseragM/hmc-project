# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=443
API_PREFIX=api/v1
# Comma-separated list of allowed CORS origins (use * for all in dev)
CORS_ORIGINS=*

# ── Sanaad gateway (reference; used by Cerner/legacy calls) ──
SANAAD_GATEWAY_BASE_URL=https://apigwuat.api.hamad.qa/sanaad

# ── Oracle (node-oracledb thick mode) ───────────────────────
# Docker/jumpstation: these are injected from the server environment (managed by
# DevOps) via docker-compose `environment:` and take precedence over this file.
# The values below are for LOCAL development only.
ORACLE_USER=xxhmc_snd
ORACLE_PASSWORD=change_me
# Easy Connect string: host:port/service_name
ORACLE_DSN=localhost:1521/XEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_TIMEOUT=60
ORACLE_QUEUE_TIMEOUT_MS=25000
ORACLE_CALL_TIMEOUT_MS=25000
# Set to true to skip creating the pool at boot (useful for local dev without Oracle)
ORACLE_DISABLED=false
# Thick mode (true) loads the Oracle Client libraries; false uses the built-in thin driver.
ORACLE_THICK_MODE=true
# Path to the Oracle Client / Instant Client libraries. Leave empty to use the
# system library path (PATH on Windows, LD_LIBRARY_PATH/ldconfig on Linux).
ORACLE_CLIENT_LIB_DIR=

# ── Auth (JWT / bearer from gateway) ────────────────────────
# NOTE: op-1 login flow is out-of-band ("Another document provided").
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=sanaad
JWT_AUDIENCE=sanaad-b2e
JWT_EXPIRES_IN=1h
# Allow unauthenticated requests in local dev (guards become permissive)
AUTH_DISABLED=false

# ── Cerner (appointments 41-44) ─────────────────────────────
CERNER_BASE_URL=https://cerner.example.hamad.qa
CERNER_TIMEOUT_MS=10000

# ── LDAP / Active Directory (auth framework: User Validate API-2 & Login API-5) ──
# Master switch; when false the app uses the dev bypass / stub adapter.
LDAP_ENABLED=false
LDAP_HOST=HMC.ORG.QA
LDAP_PORT=636
# true = LDAPS (SSL, port 636); false = plain LDAP (port 389)
LDAP_USE_SSL=true
# Optional explicit URL; leave empty to derive from host/port/ssl (e.g. ldaps://HMC.ORG.QA:636)
LDAP_URL=
# UPN suffix for direct binds (username@LDAP_UPN_DOMAIN) used by authenticate();
# leave empty to default to LDAP_HOST.
LDAP_UPN_DOMAIN=
LDAP_BASE_DN=DC=hmc,DC=org,DC=qa
# {username} is replaced with the sanitized login name at search time — used by validate() only
LDAP_SEARCH_FILTER=(sAMAccountName={username})
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
# Service/bind account used by validate()'s search (NOT needed for authenticate()'s direct bind)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# true in production (valid CA); false to accept self-signed certs in test.
# Set this true ONLY once LDAP_CA_CERT / LDAP_CA_CERT_PATH is configured below
# — otherwise every LDAPS bind fails with a self-signed-certificate TLS error.
LDAP_TLS_REJECT_UNAUTHORIZED=false
# CA certificate to trust for LDAPS (HMC's internal/self-signed AD CA).
# Option A — inline PEM, single line, real newlines escaped as \n:
# LDAP_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----\n
# Option B — a file path (mount the cert into the container if using Docker):
# LDAP_CA_CERT_PATH=/certs/hmc-ad-ca.pem
# Inline wins if both are set. Leave both empty only for a quick connectivity
# test with LDAP_TLS_REJECT_UNAUTHORIZED=false.
LDAP_CA_CERT=
LDAP_CA_CERT_PATH=
LDAP_TIMEOUT_MS=10000

# ── Misc ────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
LOV_CACHE_TTL_MS=300000
LOG_LEVEL=debug
