# ── Application ─────────────────────────────────────────────
NODE_ENV=development
GATEWAY_PORT=3002
API_PREFIX=api/v1
# Comma-separated list of allowed CORS origins (use * for all in dev)
CORS_ORIGINS=*

# ── Upstream backend (HMC_BackEnd) ──────────────────────────
BACKEND_BASE_URL=http://localhost:3000
BACKEND_API_PREFIX=api/v1
# Keep >= HMC_BackEnd's own REQUEST_TIMEOUT_MS so the gateway doesn't time
# out a request the backend is still legitimately processing.
BACKEND_TIMEOUT_MS=30000

# ── Auth (JWT) ───────────────────────────────────────────────
# MUST match HMC_BackEnd's JWT_SECRET/JWT_ISSUER/JWT_AUDIENCE exactly — the
# gateway verifies tokens issued by HMC_BackEnd's /auth/login locally,
# without an extra round trip back to the backend.
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=sanaad
JWT_AUDIENCE=sanaad-b2e
JWT_EXPIRES_IN=1h
# Allow unauthenticated requests in local dev (guard becomes permissive)
AUTH_DISABLED=true

# ── Rate limiting (login / OTP / MPIN attempt endpoints) ────
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000

# ── Misc ────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=35000
LOG_LEVEL=debug
