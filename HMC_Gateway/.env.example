# ── Application ─────────────────────────────────────────────
NODE_ENV=development
GATEWAY_PORT=443
API_PREFIX=api/v1
# Comma-separated list of allowed CORS origins (use * for all in dev)
CORS_ORIGINS=*

# ── Upstream backend (HMC_BackEnd) ──────────────────────────
BACKEND_BASE_URL=https://sanaadstg.hamad.qa:443
BACKEND_API_PREFIX=api/v1
# Keep >= HMC_BackEnd's own REQUEST_TIMEOUT_MS so the gateway doesn't time
# out a request the backend is still legitimately processing.
BACKEND_TIMEOUT_MS=30000
# ── TLS to an https:// backend ──
# Preferred: keep validation ON and trust the internal CA explicitly —
# Option A — inline PEM, single line, real newlines escaped as \n:
# BACKEND_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----\n
# Option B — a file path (mount the cert into the container if using Docker):
# BACKEND_CA_CERT_PATH=/certs/hmc-backend-ca.pem
BACKEND_CA_CERT=
BACKEND_CA_CERT_PATH=
# Last resort for a self-signed backend cert with no CA available: set false to
# DISABLE certificate validation (equivalent of .NET's trust-all
# ServerCertificateValidationCallback). Never leave false in production.
BACKEND_TLS_REJECT_UNAUTHORIZED=false

# ── Auth (JWT) ───────────────────────────────────────────────
# MUST match HMC_BackEnd's JWT_SECRET/JWT_ISSUER/JWT_AUDIENCE exactly — the
# gateway verifies tokens issued by HMC_BackEnd's /auth/login locally,
# without an extra round trip back to the backend.
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=sanaad
JWT_AUDIENCE=sanaad-b2e
JWT_EXPIRES_IN=1h
# Allow unauthenticated requests in local dev (guard becomes permissive)
AUTH_DISABLED=true

# ── Rate limiting (login / OTP / MPIN attempt endpoints) ────
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000

# ── Misc ────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=35000
LOG_LEVEL=debug
